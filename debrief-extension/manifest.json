{
  "manifest_version": 3,
  "name": "Debrief: Surgical Browser Assistant",
  "version": "1.0",
  "description": "Primary voice-intent capture and browser declutter tool.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "ws://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "trigger-debrief": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Trigger Surgical Capture & Voice Recording"
    },
    "open-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Debrief Sidebar"
    }
  },
  "action": {
    "default_title": "Debrief Settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "externally_connectable": {
    "matches": ["http://localhost:4321/*"]
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/integrations/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
